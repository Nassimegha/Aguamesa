{
  "private": true,
  "name": "aguamesa",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "dev:local": "vite --config tools/vite.local.ts",
    "launch": "npm run deploy && devvit publish",
    "levels": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/client/game/dev/buildLevels.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --import ./tools/test-register.mjs --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.4",
    "@devvit/web": "0.15.4",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.4",
    "hono": "4.13.17",
    "meshoptimizer": "^1.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.187.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  }
}